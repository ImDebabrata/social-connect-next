{
  "name": "chat-service",
  "version": "1.0.0",
  "main": "./src/index.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "env:dev": "cp .env.dev .env && echo 'Chat service switched to DEVELOPMENT (.env)'",
    "env:prod": "cp .env.prod .env && echo 'Chat service switched to PRODUCTION (.env)'",
    "dev": "cp .env.dev .env && ts-node src/index.ts",
    "dev:prod": "cp .env.prod .env && ts-node src/index.ts",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.14",
    "@types/socket.io": "^3.0.2",
    "prisma": "7.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@types/cors": "^2.8.17",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jose": "^5",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1"
  }
}
