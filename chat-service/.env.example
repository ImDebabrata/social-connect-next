# Chat service configuration
# Local only. Do not set PORT on Render — the platform injects it.
PORT=3001

# Origin of the Next.js web app. Required for CORS + cookie-based socket auth
# (must be an exact origin, not "*", when credentials are used).
APP_URL=http://localhost:3000

# Shared with the web app. Used to verify the session JWT from the cookie.
JWT_SECRET=

# Prisma connection string (shared with the web app / repo-root .env).
POSTGRES_PRISMA_URL=
