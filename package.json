  "scripts": {
    "env:dev": "cp .env.dev .env && echo 'Switched to DEVELOPMENT (.env)'",
    "env:prod": "cp .env.prod .env && echo 'Switched to PRODUCTION (.env)'",
    "dev": "cp .env.dev .env && next dev --turbopack",
    "dev:prod": "cp .env.prod .env && next dev --turbopack",
    "build": "prisma migrate deploy && next build",
